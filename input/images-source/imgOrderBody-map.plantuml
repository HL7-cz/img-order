@startuml
hide circle
hide stereotype
hide members
hide methods
skinparam linetype ortho
skinparam class {
BackgroundColor<<LogicalModel>> #APPLICATION
BackgroundColor<<Profile>> #TECHNOLOGY
}
legend right
| <#APPLICATION>  Logical Model |
| <#TECHNOLOGY>  Profile |
endlegend
class "Imaging Order Body" <<LogicalModel>> [[StructureDefinition-BodyImageOrderCz.html]]

class "cz-imagingOrderInformation" <<Profile>> [[StructureDefinition-cz-imagingOrderInformation.html]]
class "condition-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-condition-cz-core.html]]
class "cz-encounter" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-cz-encounter.html]]
class "cz-coverage" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-cz-coverage.html]]
class "appointment-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-appointment-cz-core.html]]
class "cz-specimen" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-cz-specimen.html]]
class "medicalTestResult-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-medicalTestResult-cz-core.html]]
class "cz-anthropometric-test-result" <<Profile>> [[StructureDefinition-cz-anthropometric-test-result.html]]
class "medicationStatement-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-medicationStatement-cz-core.html]]
class "immunization-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-immunization-cz-core.html]]
class "deviceUseStatement-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-deviceUseStatement-cz-core.html]]
class "allergyIntolerance-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-allergyIntolerance-cz-core.html]]
class "carePlan-cz-core" <<Profile>> [[https://hl7.cz/fhir/core/StructureDefinition-carePlan-cz-core.html]]

"Imaging Order Body" <|. "cz-imagingOrderInformation"
"Imaging Order Body" <|. "cz-appointment"
"Imaging Order Body" <|. "cz-coverage"
"Imaging Order Body" <|. "cz-conditionCore"
"Imaging Order Body" <|. "cz-encounter"
"Imaging Order Body" <|. "cz-specimen"
"Imaging Order Body" <|. "medicalTestResult-cz-core"
"Imaging Order Body" <|. "cz-anthropometric-test-result"
"Imaging Order Body" <|. "cz-MedicationStatement"
"Imaging Order Body" <|. "cz-Immunization"
"Imaging Order Body" <|. "cz-deviceUseStatement"
"Imaging Order Body" <|. "cz-allergyIntolerance"
"Imaging Order Body" <|. "cz-carePlanImage"

"cz-imagingOrderInformation" -d[hidden]-> "cz-encounter"
"cz-encounter" -d[hidden]-> "cz-conditionCore"
"cz-conditionCore" -d[hidden]-> "cz-appointment"
"cz-appointment" -d[hidden]-> "cz-coverage"
"cz-coverage" -d[hidden]-> "cz-specimen"
"cz-specimen" -d[hidden]-> "medicalTestResult-cz-core"
"medicalTestResult-cz-core" -d[hidden]-> "cz-anthropometric-test-result"
"cz-anthropometric-test-result" -d[hidden]-> "cz-MedicationStatement"
"cz-MedicationStatement" -d[hidden]-> "cz-Immunization"
"cz-Immunization" -d[hidden]-> "cz-deviceUseStatement"
"cz-deviceUseStatement" -d[hidden]-> "cz-allergyIntolerance"
"cz-allergyIntolerance" -d[hidden]-> "cz-carePlanImage"

@enduml
